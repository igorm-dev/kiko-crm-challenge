NODE_ENV=development
PORT=3000
# Host port 5433 (see docker-compose.yml) to avoid clashing with a local Postgres.
DATABASE_URL=postgres://kiko:kiko@localhost:5433/kiko_crm
CORS_ORIGIN=http://localhost:5173

# At least 32 characters. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-random-string-with-at-least-32-chars
# Accepts any ms/vercel duration: 30m, 8h, 7d.
JWT_EXPIRES_IN=8h
