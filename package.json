{
    "name": "kiko-crm-challenge",
    "version": "0.0.0",
    "private": true,
    "description": "B2B sales CRM (leads, deals, Kanban pipeline) for Kiko's fitness equipment business",
    "license": "MIT",
    "packageManager": "pnpm@11.15.1",
    "engines": {
        "node": ">=22",
        "pnpm": ">=11"
    },
    "scripts": {
        "build": "pnpm -r run build",
        "dev": "pnpm --filter @kiko/contracts build && pnpm -r --parallel run dev",
        "lint": "pnpm -r run lint",
        "test": "pnpm -r run test",
        "typecheck": "pnpm -r run typecheck",
        "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
        "db:up": "docker compose up -d",
        "db:down": "docker compose down",
        "migration:generate": "pnpm --filter @kiko/api migration:generate",
        "migration:run": "pnpm --filter @kiko/api migration:run",
        "db:seed": "pnpm --filter @kiko/api db:seed",
        "migration:run:prod": "pnpm --filter @kiko/api migration:run:prod",
        "db:seed:prod": "pnpm --filter @kiko/api db:seed:prod",
        "start:api": "pnpm --filter @kiko/api start"
    },
    "devDependencies": {
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^5.7.3"
    }
}
